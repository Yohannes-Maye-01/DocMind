# ─────────────────────────────────────────────────
#  DocMind – Environment Variables Template
#  Copy this file to .env and fill in real values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────
POSTGRES_USER=docmind
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=docmind_db

# ── Go Backend ──────────────────────────────────
JWT_SECRET=change_me_at_least_32_chars_long!!
PORT=8080

# ── Rust Search Service ─────────────────────────
SEARCH_PORT=8081

# ── Python AI Service ───────────────────────────
AI_PORT=8082
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Options: mistral:7b-q4, phi:2 (smaller/faster)
OLLAMA_MODEL=phi:2

# ── Typesense ───────────────────────────────────
TYPESENSE_URL=http://typesense:8108
TYPESENSE_API_KEY=change_me_typesense_key
TYPESENSE_COLLECTION=docmind_chunks

# ── Ollama ──────────────────────────────────────
OLLAMA_URL=http://ollama:11434

# ── Frontend ────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
